#!/usr/bin/env zsh
# No `set -e`: this is a long-running interactive loop — a failed step should
# print its error and return to the menu, not exit the whole program.
SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/lib/music-core.sh"

read_path() {  # prints a cleaned drag-and-drop path
  local p; read "p?> "
  p="${p//\\ / }"
  print -- "${p%"${p##*[! ]}"}"
}

while true; do
  echo ""
  echo "Music Toolkit"
  echo "-------------"
  echo "Turn songs into stems, one-shots & samples for flipping. Pick a step:"
  echo "0) Guide / how it works"
  echo "L) Browse music library (pick a file, then a step)"
  echo "M) Bass stem -> MIDI"
  echo "O) Open outputs in Finder"
  echo "P) Build Logic project from stems"
  echo "R) Re-voice a melody as another instrument"
  echo "1) Download"
  echo "2) Separate stems"
  echo "3) Chop vocals"
  echo "4) Split drums (one-shots)"
  echo "5) Chop stems into snippets"
  echo "6) Sort drum kit (kick/snare/hat)"
  echo "7) Analyze tempo & key"
  echo "8) Deconstruct a track (stems → one-shots → kit → snippets)"
  echo "9) Full pipeline (download → stems → chop)"
  echo "10) Quit"
  read "choice?> "

  case "$choice" in
    0)
      cat <<'GUIDE'

Guide — how to flip a track
---------------------------
Fastest path (recommended):
  1) Download      paste a URL; saves .m4a into Apple Music/
  8) Deconstruct   drag that file, pick "loose" — chains everything:
                   analyze (BPM+key) -> 4-stem split -> drum one-shots ->
                   sort kit (kick/snare/hat) -> fixed-length stem snippets.
  Everything lands under Samples/, ready to drag into Logic.

Manual path (control at each step):
  1 Download -> 7 Analyze (set project tempo/key first) -> 2 Separate stems
  then branch by what you need:
    3 Chop vocals       phrase-length vocal clips  (Samples/Vocals/)
    4 Split drums       one-shot hits, then 6 Sort kit -> kick/snare/hat
    5 Chop stems        fixed 8s chunks of every stem (Samples/Chops/)

Pick what you need:
  Sample-flip fast ....... 8
  Acapella / instrumental  2 (instrumental) -> 3
  Build a drum kit ....... 2 -> 4 -> 6

Density / sensitivity: "loose" = more, longer clips; "tight" = fewer, cleaner.
Start loose, tighten if you get too much noise.

Input: Download/Full pipeline take a pasted URL; everything else takes a
file/folder dragged from Finder into the terminal.
GUIDE
      ;;
    L|l)
      files=("${(@f)$(find "$SCRIPT_DIR/Apple Music" "$SCRIPT_DIR/SoundCloud" "$SCRIPT_DIR/Downloads" -type f \( -name '*.m4a' -o -name '*.mp3' -o -name '*.flac' -o -name '*.wav' \) 2>/dev/null | sort)}")
      [[ ${#files} -eq 0 ]] && { echo "No audio files found in Apple Music/, SoundCloud/, or Downloads/."; continue; }
      read "q?Filter by name (blank = all)> "
      if [[ -n "$q" ]]; then
        filtered=(); for f in "${files[@]}"; do [[ "${f:l}" == *"${q:l}"* ]] && filtered+=("$f"); done
        files=("${filtered[@]}")
        [[ ${#files} -eq 0 ]] && { echo "No matches for '$q'."; continue; }
      fi
      echo "Music library:"
      i=1; for f in "${files[@]}"; do printf " %2d) %s / %s\n" "$i" "${f:h:t}" "${f:t}"; ((i++)); done
      read "n?Pick a file #> "
      if [[ -z "$n" || ! "$n" == <-> || "$n" -lt 1 || "$n" -gt ${#files} ]]; then echo "Invalid."; continue; fi
      INPUT="${files[$n]}"
      echo "Selected: ${INPUT:t}"
      echo "Run: 1) Deconstruct [recommended]  2) Separate stems  3) Analyze  4) Chop vocals"; read "act?> "
      case "$act" in
        1|"")
          echo "Drum density: 1) tight  2) loose [recommended]"; read "d?> "
          case "$d" in 1) DENS=tight;; *) DENS=loose;; esac
          deconstruct "$INPUT" "$DENS"
          ;;
        2)
          echo "Mode: 1) instrumental  2) 4stem [recommended]  3) 6stem"; read "m?> "
          case "$m" in 1) MODE=instrumental;; 3) MODE=6stem;; *) MODE=4stem;; esac
          separate_stems "$INPUT" "$MODE" "$SCRIPT_DIR/Stems"
          ;;
        3) analyze_track "$INPUT" ;;
        4)
          track="${INPUT:t:r}"
          vocals=""
          for m in htdemucs htdemucs_6s; do
            [[ -f "$SCRIPT_DIR/Stems/$m/$track/vocals.wav" ]] && vocals="$SCRIPT_DIR/Stems/$m/$track/vocals.wav" && break
          done
          [[ -z "$vocals" ]] && { echo "No stems for '$track' yet — run Separate stems or Deconstruct first."; continue; }
          echo "Sensitivity: 1) tight  2) loose [recommended]"; read "s?> "
          case "$s" in 1) SENS=tight;; *) SENS=loose;; esac
          chop_vocals "$vocals" "$SCRIPT_DIR/Samples/Vocals" "$SENS"
          ;;
        *) echo "Invalid."; continue ;;
      esac
      ;;
    M|m)
      echo "Drag a bass.wav or a Stems track folder:"; INPUT=$(read_path)
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      if [[ -d "$INPUT" ]]; then
        BASS=$(find "$INPUT" -type f -name 'bass.wav' | head -1)
        [[ -z "$BASS" ]] && { echo "No bass.wav under that folder."; continue; }
      else
        BASS="$INPUT"
      fi
      read "tempo?Tempo BPM [120]> "; [[ -z "$tempo" ]] && tempo=120
      OUT="$SCRIPT_DIR/Samples/MIDI/${BASS:h:t}_bass.mid"
      mkdir -p "${OUT:h}"
      bass_to_midi "$BASS" "$OUT" "$tempo"
      ;;
    O|o)
      open "$SCRIPT_DIR/Samples" 2>/dev/null || echo "Samples/ not found — run a step first."
      ;;
    P|p)
      echo "Drag a Stems track folder (with drums/bass/other/vocals.wav):"; INPUT=$(read_path)
      [[ ! -d "$INPUT" ]] && { echo "Need a Stems track folder."; continue; }
      echo "Analyzing for tempo/key…"
      analyze_track "$INPUT"
      build_logic_project "$INPUT"
      ;;
    R|r)
      echo "Drag a monophonic melodic stem (.wav — a lead/bass/vocal line):"; INPUT=$(read_path)
      [[ ! -f "$INPUT" ]] && { echo "Need an audio file."; continue; }
      echo "Target instrument:"
      echo "  1) guitar  2) guitar-steel  3) piano  4) epiano  5) strings"
      echo "  6) bells   7) flute         8) synth  9) organ  10) brass"
      read "ins?> "
      case "$ins" in
        1|"") INSTR=guitar;; 2) INSTR=guitar-steel;; 3) INSTR=piano;; 4) INSTR=epiano;;
        5) INSTR=strings;; 6) INSTR=bells;; 7) INSTR=flute;; 8) INSTR=synth;;
        9) INSTR=organ;; 10) INSTR=brass;; *) echo "Invalid."; continue;;
      esac
      read "tempo?Tempo BPM [120]> "; [[ -z "$tempo" ]] && tempo=120
      resynth_instrument "$INPUT" "$SCRIPT_DIR/Samples/Resynth/${INPUT:t:r}" "$INSTR" "$tempo"
      ;;
    1)
      read "url?Paste URL> "
      [[ -z "$url" ]] && { echo "No URL."; continue; }
      download_url "$url" "$SCRIPT_DIR/Apple Music"
      ;;
    2)
      echo "Drag a file or folder:"; INPUT=$(read_path)
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      echo "Mode: 1) instrumental  2) 4stem [recommended]  3) 6stem"; read "m?> "
      case "$m" in 1) MODE=instrumental;; 3) MODE=6stem;; 2|"") MODE=4stem;; *) echo "Invalid."; continue;; esac
      if [[ -f "$INPUT" ]]; then
        separate_stems "$INPUT" "$MODE" "$SCRIPT_DIR/Stems"
      else
        find "$INPUT" -type f \( -name '*.m4a' -o -name '*.mp3' -o -name '*.flac' -o -name '*.wav' \) | while read -r f; do
          echo "Processing: ${f:t}"; separate_stems "$f" "$MODE" "$SCRIPT_DIR/Stems"
        done
      fi
      ;;
    3)
      echo "Drag a vocals.wav or Stems folder:"; INPUT=$(read_path)
      [[ -z "$INPUT" ]] && INPUT="$SCRIPT_DIR/Stems"
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      echo "Sensitivity: 1) tight  2) loose [recommended]"; read "s?> "
      case "$s" in 1) SENS=tight;; 2) SENS=loose;; *) SENS=loose;; esac
      chop_vocals "$INPUT" "$SCRIPT_DIR/Samples/Vocals" "$SENS"
      ;;
    4)
      echo "Drag a drums.wav or Stems folder:"; INPUT=$(read_path)
      [[ -z "$INPUT" ]] && INPUT="$SCRIPT_DIR/Stems"
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      echo "Density: 1) tight  2) loose [recommended]"; read "d?> "
      case "$d" in 1) DENS=tight;; 2) DENS=loose;; *) DENS=loose;; esac
      chop_drums "$INPUT" "$SCRIPT_DIR/Samples/One-Shots" "$DENS"
      ;;
    5)
      echo "Drag a Stems track folder (or a stem .wav):"; INPUT=$(read_path)
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      read "secs?Snippet length in seconds [8]> "; [[ -z "$secs" ]] && secs=8
      chop_stems "$INPUT" "$SCRIPT_DIR/Samples/Chops" "$secs"
      ;;
    6)
      echo "Drag a One-Shots folder to sort:"; INPUT=$(read_path)
      [[ ! -d "$INPUT" ]] && { echo "Invalid folder."; continue; }
      sort_kit "$INPUT"
      ;;
    7)
      echo "Drag an audio file or folder:"; INPUT=$(read_path)
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      analyze_track "$INPUT"
      ;;
    8)
      echo "Drag an audio file to deconstruct:"; INPUT=$(read_path)
      [[ ! -f "$INPUT" ]] && { echo "Need an audio file."; continue; }
      echo "Drum density: 1) tight  2) loose [recommended]"; read "d?> "
      case "$d" in 1) DENS=tight;; 2) DENS=loose;; *) DENS=loose;; esac
      deconstruct "$INPUT" "$DENS"
      read "yn?Build Logic project from these stems now? [y/N]> "
      if [[ "$yn" == (y|Y|yes) ]]; then
        build_logic_project "$SCRIPT_DIR/Stems/htdemucs/${INPUT:t:r}"
      fi
      ;;
    9)
      read "url?Paste URL> "
      [[ -z "$url" ]] && { echo "No URL."; continue; }
      STAMP=$(date +%s)
      download_url "$url" "$SCRIPT_DIR/Apple Music"
      new_files=$(find_new_m4a "$SCRIPT_DIR/Apple Music" "$STAMP")
      if [[ -z "$new_files" ]]; then
        echo "Nothing downloaded — aborting pipeline."; continue
      fi
      echo "$new_files" | while read -r track; do
        echo "→ Stems: ${track:t}"
        vocals=$(separate_stems "$track" instrumental "$SCRIPT_DIR/Stems" | tail -1)
        if [[ ! -f "$vocals" ]]; then
          echo "  no vocals.wav for ${track:t} — skipping chop."; continue
        fi
        echo "→ Chop: ${vocals:h:t}"
        chop_vocals "$vocals" "$SCRIPT_DIR/Samples/Vocals" loose
      done
      echo "Pipeline complete."
      ;;
    10) echo "Bye."; exit 0 ;;
    *) echo "Invalid choice."; continue ;;
  esac
done
