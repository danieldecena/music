#!/usr/bin/env zsh
# No `set -e`: this is a long-running interactive loop — a failed step should
# print its error and return to the menu, not exit the whole program.
SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/lib/music-core.sh"

read_path() {  # prints a cleaned drag-and-drop path
  local p; read "p?> "
  clean_path "$p"
}

resolve_input() {  # mode=source: current track's source, else a dragged path or a pasted URL
  if [[ -n "$CUR_SRC" ]]; then
    local p; read "p?Input: [Enter] = $CUR_LABEL  (or drag a different file)> "
    if [[ -z "$p" ]]; then print -- "$CUR_SRC"; return; fi
    clean_path "$p"
  else
    local p; echo "Type a song title (typos OK) or drag a file/folder:" >&2; read "p?> "
    if [[ "$p" == http*://* ]]; then print -- "$p"; return; fi
    resolve_target "$p"
  fi
}

resolve_stems() {  # echoes current track's Stems dir, or a dragged path; empty if unavailable
  if [[ -n "$CUR_NAME" ]]; then
    local d; d="$(stems_dir_for "$CUR_NAME")"
    if [[ -n "$d" ]]; then
      local p; read "p?Stems: [Enter] = $CUR_NAME  (or drag a folder/stem)> "
      if [[ -z "$p" ]]; then print -- "$d"; return; fi
      clean_path "$p"
      return
    fi
    echo "No stems for $CUR_NAME yet — run Separate (2) or Deconstruct (8) first." >&2
    return
  fi
  local p; echo "Type a song title (typos OK) or drag a folder/stem:" >&2; read "p?> "
  resolve_target "$p"
}

select_file() {  # $1 = path to an audio file; makes it the current track
  # name derived as basename-without-extension, matching deconstruct's
  # Stems/htdemucs/<name> convention so scan_track/stems_dir_for line up.
  CUR_SRC="$1"; CUR_NAME="${1:t:r}"; CUR_LABEL="${1:t:r}"
}

download_and_select() {  # $1 = url; downloads then auto-selects (sets CUR_*). 0 on success.
  local files rc
  files=$(download_and_locate "$1" "$SCRIPT_DIR/Apple Music"); rc=$?
  if (( rc != 0 )); then echo "Download failed (exit $rc)."; return 1; fi
  if [[ -z "$files" ]]; then echo "Nothing new downloaded (a file that already existed is skipped)."; return 1; fi
  local -a arr=("${(@f)files}")
  local pick=1
  if (( ${#arr} > 1 )); then
    echo "Downloaded ${#arr} tracks:"
    local i=1 f; for f in "${arr[@]}"; do printf "  %d) %s\n" "$i" "${f:t}"; ((i++)); done
    read "pick?Pick a file #> "
    [[ "$pick" == <-> && "$pick" -ge 1 && "$pick" -le ${#arr} ]] || { echo "Invalid pick."; return 1; }
  fi
  select_file "${arr[$pick]}"
  echo "Selected: $CUR_NAME"
}

CUR_SRC=""; CUR_NAME=""; CUR_LABEL=""

HAS_STEMS=0; HAS_DRUMS=0; HAS_SHOTS=0; HAS_KIT=0; HAS_CHOPS=0
scan_track() {  # unpack track_state into the flags the progress row and Next: read
  if [[ -z "$CUR_NAME" ]]; then
    HAS_STEMS=0; HAS_DRUMS=0; HAS_SHOTS=0; HAS_KIT=0; HAS_CHOPS=0
    return
  fi
  local s=(${=$(track_state "$CUR_NAME")})
  HAS_STEMS=$s[1]; HAS_DRUMS=$s[2]; HAS_SHOTS=$s[3]; HAS_KIT=$s[4]; HAS_CHOPS=$s[5]
}

box() { (( $1 )) && print -n "[x]" || print -n "[ ]" }

next_step() {  # the one action the current state implies
  if [[ -z "$CUR_NAME" ]]; then print -- "1  Download a song      (or  L  to pick one you have)"
  elif (( ! HAS_STEMS ));  then print -- "8  Deconstruct          (or  2  to split stems only)"
  elif (( ! HAS_DRUMS ));  then print -- "3  Chop vocals          (acapella split — no drums to slice)"
  elif (( ! HAS_SHOTS ));  then print -- "4  Split drums"
  elif (( ! HAS_KIT ));    then print -- "6  Sort drum kit"
  elif (( ! HAS_CHOPS ));  then print -- "5  Chop stems"
  else                          print -- "nothing — this one's fully prepped.  O  opens Samples/"
  fi
}

if [[ -t 1 ]]; then
  c_b=$'\e[1m' c_d=$'\e[2m' c_k=$'\e[36;1m' c_x=$'\e[0m'
else
  c_b= c_d= c_k= c_x=
fi
heading() {  # $1 = title, $2 = current track
  printf "  %s%s%s  ·  %s\n  %s------------------------------------------------------------%s\n" "$c_b" "$1" "$c_x" "$2" "$c_d" "$c_x"
}
section() { printf "  %s%s%s\n" "$c_b" "$1" "$c_x" }
row() {  # $1 = key, $2 = label, $3 = optional description
  if [[ -n "$3" ]]; then
    printf "    %s%-2s%s %-20s %s%s%s\n" "$c_k" "$1" "$c_x" "$2" "$c_d" "$3" "$c_x"
  else
    printf "    %s%-2s%s %s\n" "$c_k" "$1" "$c_x" "$2"
  fi
}

MENU=main
while true; do
  echo ""
  # the catalog label ends in its own "[deconstructed: ...]" summary — drop it, the
  # progress row says the same thing per-output. `%` not `%%`: the shortest suffix
  # cuts at the last "  [", so a title like "Song  [Live]" keeps its BPM and key.
  CUR_SHORT="${CUR_LABEL%  \[*}"
  if [[ "$MENU" == tools ]]; then
    heading "Tools" "${CUR_SHORT:-no track selected}"
    row A "Stem levels"        "loudness / presence per stem"
    row H "Guitar chords"      "chart, or write to Music lyrics"
    row X "Mix-match"          "catalog pairs that mix well"
    row Z "Mix report"         "what mixes with one track you name"
    row C "Combine two tracks" "layer or transition, cut on the bar grid"
    row T "Tempo lock"         "settle BPM by ear (click A/B)"
    row M "Bass stem -> MIDI"
    row R "Re-voice a melody"  "as another instrument"
    row P "Build Logic project"
    row 9 "Download + chop"    "URL straight to vocal clips"
    echo ""
    row B "Back"
  else
    scan_track
    heading "Music Toolkit" "${CUR_SHORT:-no track selected}"
    if [[ -n "$CUR_NAME" ]]; then
      echo "  stems $(box $HAS_STEMS)   one-shots $(box $HAS_SHOTS)   kit $(box $HAS_KIT)   chops $(box $HAS_CHOPS)"
    else
      echo "  ${c_d}Turn songs into stems, one-shots & samples for flipping.${c_x}"
    fi
    echo "  Next:  $(next_step)"
    echo ""
    section "THE FLIP PATH"
    row 1 "Download"       "paste a URL, saves into Apple Music/"
    row 8 "Deconstruct"    "everything below, in one go"
    row 2 "Separate stems"
    row 7 "Tempo & key"
    row 3 "Chop vocals"
    row 4 "Split drums"
    row 6 "Sort drum kit"
    row 5 "Chop stems"
    echo ""
    section "EXTRAS"
    row H "Guitar chords"  "chart, or write to Music lyrics"
    row L "Browse tracks"
    row O "Open Samples/"
    row T "More tools"
    echo ""
    [[ -n "$CUR_NAME" ]] && row C "Clear track"
    row G "Guide"
    row Q "Quit"
  fi
  read "choice?> " || { echo; exit 0; }  # input closed: without this the menu spins forever

  # The Tools menu reuses C and T, which the main-menu arms below match first;
  # give the Tools entries their own names so they are reachable.
  if [[ "$MENU" == tools ]]; then
    case "$choice" in C|c) choice=combine ;; T|t) choice=tempolock ;; esac
  fi

  case "$choice" in
    "") continue ;;
    T|t) MENU=tools ;;
    B|b) MENU=main ;;
    G|g|0)
      cat <<'GUIDE'

Guide — how to flip a track
---------------------------
Fastest path (recommended):
  1) Download      paste a URL; saves .m4a into Apple Music/
  8) Deconstruct   drag that file, pick "loose" — chains everything:
                   analyze (BPM+key) -> 4-stem split -> drum one-shots ->
                   sort kit (kick/snare/hat) -> fixed-length stem snippets.
  Everything lands under Samples/, ready to drag into Logic.

Manual path (control at each step):
  1 Download -> 7 Analyze (set project tempo/key first) -> 2 Separate stems
  then branch by what you need:
    3 Chop vocals       phrase-length vocal clips  (Samples/Vocals/)
    4 Split drums       one-shot hits, then 6 Sort kit -> kick/snare/hat
    5 Chop stems        fixed 8s chunks of every stem (Samples/Chops/)

Pick what you need:
  Sample-flip fast ....... 8
  Acapella / instrumental  2 (acapella) -> 3
  Build a drum kit ....... 2 -> 4 -> 6

Density / sensitivity: "loose" = more, longer clips; "tight" = fewer, cleaner.
Start loose, tighten if you get too much noise.

Input: Download/Full pipeline take a pasted URL; everything else takes a
file/folder dragged from Finder into the terminal.
GUIDE
      ;;
    L|l)
      "$SCRIPT_DIR/.venv/bin/python" "$SCRIPT_DIR/Scripts/catalog.py" scan >/dev/null 2>&1
      read "q?Search (blank = all, name/artist)> "
      lines=("${(@f)$("$SCRIPT_DIR/.venv/bin/python" "$SCRIPT_DIR/Scripts/catalog.py" search "$q" --menu 2>/dev/null)}")
      lines=("${(@)lines:#}")
      [[ ${#lines} -eq 0 ]] && { echo "No matches. (Download or Scan first if the library is new.)"; continue; }
      total=${#lines}
      shown=$(( total > 40 ? 40 : total ))
      echo "Music library:"
      for i in {1..$shown}; do
        printf " %2d) %s\n" "$i" "${lines[$i]##*$'\t'}"
      done
      (( total > shown )) && echo "  ... +$(( total - shown )) more — refine your search."
      read "n?Pick a file #> "
      if [[ -z "$n" || ! "$n" == <-> || "$n" -lt 1 || "$n" -gt $shown ]]; then echo "Cancelled."; continue; fi
      line="${lines[$n]}"
      CUR_NAME="${line%%$'\t'*}"
      rest="${line#*$'\t'}"
      src="${rest%%$'\t'*}"
      CUR_LABEL="${rest#*$'\t'}"
      if [[ -n "$src" ]]; then CUR_SRC="$SCRIPT_DIR/$src"; else CUR_SRC=""; fi
      echo "Selected: $CUR_LABEL"
      ;;
    C|c)
      CUR_SRC=""; CUR_NAME=""; CUR_LABEL=""
      echo "Current track cleared."
      ;;
    A|a)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      analyze_stems "$INPUT"
      ;;
    H|h)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      chord_progression "$INPUT" || continue
      read "yn?Write these chords into the song's Lyrics in Apple Music? [y/N]> "
      [[ "$yn" == (y|Y|yes) ]] || continue
      deflt="${CUR_NAME#<-> }"
      read "q?Song title to find in Music [$deflt]> "; : "${q:=$deflt}"
      [[ -z "$q" ]] && continue
      tb=$'\t'
      matches=("${(@f)$(music_find_tracks "$q")}"); matches=("${(@)matches:#}")
      if (( ${#matches} == 0 )); then
        echo "No local-file track matching '$q' in Music (streaming tracks cannot hold lyrics)."; continue
      fi
      pick=1
      if (( ${#matches} > 1 )); then
        i=1; for m in "${matches[@]}"; do printf "  %d) %s\n" "$i" "${${m#*$tb}//$tb/  -  }"; ((i++)); done
        read "pick?Pick # (Enter = cancel)> "
        (( ${pick:-0} >= 1 && ${pick:-0} <= ${#matches} )) 2>/dev/null || { echo "Cancelled."; continue; }
      fi
      tmp=$(mktemp)
      if chords_lyrics_text "$INPUT" > "$tmp"; then
        push_lyrics "${matches[$pick]%%$tb*}" "$tmp"
      else
        echo "Chord analysis failed."
      fi
      rm -f "$tmp"
      ;;
    X|x)
      read "ly?Match lyric themes too? (slower, needs network) [y/N]> "
      if [[ "$ly" == (y|Y|yes) ]]; then mix_match --lyrics; else mix_match; fi
      ;;
    Z|z)
      read "seed?Track title (typos OK)> "
      [[ -z "$seed" ]] && continue
      read "pv?Play a preview of the top pair? [y/N]> "
      if [[ "$pv" == (y|Y|yes) ]]; then
        mix_report "$seed" --lyrics --preview
      else
        mix_report "$seed" --lyrics
      fi
      ;;
    combine)
      # Cuts both tracks on their persisted bar grids. Needs a bar grid on each,
      # which deconstruct now records; a track analyzed before that reports it.
      read "ta?Track A, the one that keeps its timing (typos OK)> "
      [[ -z "$ta" ]] && continue
      read "abar?Start A at which bar? (see Z's loop candidates)> "
      [[ -z "$abar" ]] && continue
      read "tb?Track B, stretched onto A's grid> "
      [[ -z "$tb" ]] && continue
      read "bbar?Start B at which bar?> "
      [[ -z "$bbar" ]] && continue
      read "nb?How many bars? [8]> "; : "${nb:=8}"
      read "md?1) layer both at once  2) transition A into B  [1]> "
      if [[ "$md" == 2 ]]; then
        mix_render transition --a "$ta" --a-bar "$abar" --b "$tb" --b-bar "$bbar" \
          --bars "$nb" --out "$SCRIPT_DIR/Exports/mix.wav" --play
      else
        read "ast?Stems from A (mix, or e.g. drums,bass) [mix]> "; : "${ast:=mix}"
        read "bst?Stems from B (mix, or e.g. vocals) [mix]> "; : "${bst:=mix}"
        mix_render layer --a "$ta" --a-bar "$abar" --a-stems "$ast" \
          --b "$tb" --b-bar "$bbar" --b-stems "$bst" \
          --bars "$nb" --out "$SCRIPT_DIR/Exports/mix.wav" --play
      fi
      ;;
    tempolock)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      read "cbpm?Base BPM estimate (blank = auto-detect)> "
      read "clab?Known label BPM to also audition (blank = none)> "
      cargs=("$INPUT")
      [[ -n "$cbpm" ]] && cargs+=(--bpm "$cbpm")
      [[ -n "$clab" ]] && cargs+=(--label "$clab")
      click_compare "${cargs[@]}"
      ;;
    M|m)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      if [[ -d "$INPUT" ]]; then
        BASS=$(find "$INPUT" -type f -name 'bass.wav' | head -1)
        [[ -z "$BASS" ]] && { echo "No bass.wav under that folder."; continue; }
      else
        BASS="$INPUT"
      fi
      read "tempo?Tempo BPM [120]> "; [[ -z "$tempo" ]] && tempo=120
      if [[ "${BASS:t}" == bass.wav ]]; then BN="${BASS:h:t}"; else BN="${BASS:t:r}"; fi
      OUT="$SCRIPT_DIR/Samples/MIDI/${BN}_bass.mid"
      mkdir -p "${OUT:h}"
      STAMPF=$(mktemp)
      bass_to_midi "$BASS" "$OUT" "$tempo"
      if [[ "$OUT" -nt "$STAMPF" ]]; then echo "Wrote $OUT"; else echo "No MIDI was written."; fi
      rm -f "$STAMPF"
      ;;
    O|o)
      open "$SCRIPT_DIR/Samples" 2>/dev/null || echo "Samples/ not found — run a step first."
      ;;
    P|p)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -d "$INPUT" ]] && { echo "Need a Stems track folder."; continue; }
      echo "Analyzing for tempo/key…"
      analyze_track "$INPUT"
      build_logic_project "$INPUT"
      ;;
    R|r)
      echo "Drag a monophonic melodic stem (.wav — a lead/bass/vocal line):"; INPUT=$(read_path)
      [[ ! -f "$INPUT" ]] && { echo "Need an audio file."; continue; }
      echo "Target instrument (type a name):"
      echo "  keys:    piano epiano harpsichord clav music-box vibraphone marimba bells organ accordion"
      echo "  guitars: guitar guitar-steel guitar-jazz guitar-clean guitar-muted"
      echo "  bass:    bass-finger bass-pick bass-synth"
      echo "  strings: violin cello harp strings choir"
      echo "  wind:    trumpet brass sax clarinet flute"
      echo "  synth:   synth synth-square synth-pad"
      echo "  world:   sitar banjo kalimba steel-drum"
      read "INSTR?Instrument [guitar]> "; [[ -z "$INSTR" ]] && INSTR=guitar
      SF=""
      fonts=("$SCRIPT_DIR"/soundfonts/*.sf2(N) "$SCRIPT_DIR"/soundfonts/*.sf3(N))
      if [[ ${#fonts} -gt 1 ]]; then
        echo "Soundfonts:"; i=1; for f in "${fonts[@]}"; do printf "  %d) %s\n" "$i" "${f:t}"; ((i++)); done
        read "sfn?Soundfont # [1]> "; [[ -z "$sfn" ]] && sfn=1
        [[ "$sfn" == <-> && "$sfn" -ge 1 && "$sfn" -le ${#fonts} ]] && SF="${fonts[$sfn]}"
      fi
      read "tempo?Tempo BPM [120]> "; [[ -z "$tempo" ]] && tempo=120
      revoice_melody "$INPUT" "$INSTR" "$tempo" "$SF"
      ;;
    1)
      read "url?Paste URL> "
      [[ -z "$url" ]] && { echo "No URL."; continue; }
      [[ "$url" == http*://* ]] || { echo "That is not a URL. For a file on this Mac use H (chords), 7 (tempo & key) or 8 (deconstruct)."; continue; }
      download_and_select "$url"
      ;;
    2)
      INPUT=$(resolve_input source)
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      if [[ "$INPUT" == "$CUR_SRC" && -n "$CUR_NAME" ]] && [[ -n "$(stems_dir_for "$CUR_NAME")" ]]; then
        read "yn?$CUR_NAME already has stems. Re-run? [y/N]> "
        [[ "$yn" == (y|Y|yes) ]] || continue
      fi
      echo "Quality: 1) fast (4-stem)  2) 6-stem  3) 6-stem HQ [recommended, slow]  4) acapella"; read "m?> "
      case "$m" in 1) MODE=fast;; 2) MODE=6stem;; 4) MODE=acapella;; 3|"") MODE=hq;; *) echo "Invalid."; continue;; esac
      if [[ -f "$INPUT" ]]; then
        separate_stems "$INPUT" "$MODE" "$SCRIPT_DIR/Stems" || echo "Separate failed for ${INPUT:t}."
      else
        nall=0; nfail=0
        for f in ${(f)"$(find "$INPUT" -type f \( -name '*.m4a' -o -name '*.mp3' -o -name '*.flac' -o -name '*.wav' \))"}; do
          echo "Processing: ${f:t}"; (( nall++ ))
          separate_stems "$f" "$MODE" "$SCRIPT_DIR/Stems" || { (( nfail++ )); echo "  failed: ${f:t}"; }
        done
        echo "Separated $(( nall - nfail )) of $nall."
      fi
      ;;
    3)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      echo "Sensitivity: 1) tight  2) loose [recommended]"; read "s?> "
      case "$s" in 1) SENS=tight;; 2) SENS=loose;; *) SENS=loose;; esac
      chop_vocals "$INPUT" "$SCRIPT_DIR/Samples/Vocals" "$SENS"
      ;;
    4)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      echo "Density: 1) tight  2) loose [recommended]"; read "d?> "
      case "$d" in 1) DENS=tight;; 2) DENS=loose;; *) DENS=loose;; esac
      chop_drums "$INPUT" "$SCRIPT_DIR/Samples/One-Shots" "$DENS"
      ;;
    5)
      INPUT=$(resolve_stems)
      [[ -z "$INPUT" ]] && continue
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      read "secs?Snippet length in seconds [8]> "; [[ -z "$secs" ]] && secs=8
      chop_stems "$INPUT" "$SCRIPT_DIR/Samples/Chops" "$secs"
      ;;
    6)
      echo "Drag a One-Shots folder to sort:"; INPUT=$(read_path)
      [[ ! -d "$INPUT" ]] && { echo "Invalid folder."; continue; }
      sort_kit "$INPUT"
      ;;
    7)
      INPUT=$(resolve_input source)
      [[ ! -e "$INPUT" ]] && { echo "Invalid path."; continue; }
      analyze_track "$INPUT"
      ;;
    8)
      INPUT=$(resolve_input source)
      if [[ "$INPUT" == http*://* ]]; then
        download_and_select "$INPUT" || continue
        INPUT="$CUR_SRC"
      fi
      [[ ! -f "$INPUT" ]] && { echo "Need an audio file — Download (1) or Browse (L) first, or paste a URL."; continue; }
      if [[ "$INPUT" == "$CUR_SRC" && -n "$CUR_NAME" ]] && [[ -n "$(stems_dir_for "$CUR_NAME")" ]]; then
        read "yn?$CUR_NAME already has stems. Re-run? [y/N]> "
        [[ "$yn" == (y|Y|yes) ]] || continue
      fi
      echo "Drum density: 1) tight  2) loose [recommended]"; read "d?> "
      case "$d" in 1) DENS=tight;; 2) DENS=loose;; *) DENS=loose;; esac
      deconstruct "$INPUT" "$DENS" || { echo "Deconstruct failed."; continue; }
      [[ -d "$SCRIPT_DIR/Stems/htdemucs/${INPUT:t:r}" ]] || { echo "No stems folder was produced."; continue; }
      read "yn?Build Logic project from these stems now? [y/N]> "
      if [[ "$yn" == (y|Y|yes) ]]; then
        build_logic_project "$SCRIPT_DIR/Stems/htdemucs/${INPUT:t:r}"
      fi
      ;;
    9)
      read "url?Paste URL> "
      [[ -z "$url" ]] && { echo "No URL."; continue; }
      [[ "$url" == http*://* ]] || { echo "That is not a URL."; continue; }
      new_files=$(download_and_locate "$url" "$SCRIPT_DIR/Apple Music")
      if [[ -z "$new_files" ]]; then
        echo "Nothing downloaded — aborting pipeline."; continue
      fi
      nl=$'\n'; nfail=0
      for track in ${(f)new_files}; do
        echo "→ Stems: ${track:t}"
        sout=$(separate_stems "$track" acapella "$SCRIPT_DIR/Stems"); rc=$?
        vocals="${sout##*$nl}"
        if (( rc != 0 )) || [[ ! -f "$vocals" ]]; then
          echo "  separation failed for ${track:t} — skipping chop."; (( nfail++ )); continue
        fi
        echo "→ Chop: ${vocals:h:t}"
        chop_vocals "$vocals" "$SCRIPT_DIR/Samples/Vocals" loose || { echo "  chop failed for ${track:t}."; (( nfail++ )); }
      done
      if (( nfail )); then echo "Pipeline finished with $nfail failure(s)."; else echo "Pipeline complete."; fi
      ;;
    Q|q|10) echo "Bye."; exit 0 ;;
    *) echo "Invalid choice."; continue ;;
  esac
done
